# Application
APP_ENV=development
APP_TIMEZONE=Asia/Manila
APP_BASE_URL=http://localhost/NewRam

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bus_fare_demo
DB_USER=bus_fare_app
DB_PASSWORD=replace-with-a-local-password
DB_TIME_ZONE=+08:00

# SMTP email
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=replace-with-your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME=Bus Fare Management System

# SMS provider
SMS_API_URL=https://api.example.test/messages
SMS_API_KEY=replace-with-your-sms-api-key
SMS_SENDER_NAME=BFMS-DEMO
